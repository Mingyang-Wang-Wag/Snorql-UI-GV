@prefix sd:      <http://www.w3.org/ns/sparql-service-description#> .
@prefix formats: <http://www.w3.org/ns/formats/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://plantmetwiki.bioinformatics.nl/sparql#service> a sd:Service ;
    sd:endpoint <https://plantmetwiki.bioinformatics.nl/sparql> ;
    sd:supportedLanguage sd:SPARQL11Query ;
    sd:resultFormat formats:Turtle , formats:RDF_XML , formats:N-Triples ,
                    formats:SPARQL_Results_JSON , formats:SPARQL_Results_XML , formats:SPARQL_Results_CSV ;
    sd:feature sd:UnionDefaultGraph , sd:BasicFederatedQuery ;
    sd:defaultDataset <https://plantmetwiki.bioinformatics.nl/sparql#dataset> .

<https://plantmetwiki.bioinformatics.nl/sparql#dataset> a sd:Dataset ;
    sd:defaultGraph [ a sd:Graph ; dcterms:isPartOf <http://rdf-plantmetwiki.bioinformatics.nl/dataset/plantcyc17.0.0-gpml2021-v3/core> ] .
